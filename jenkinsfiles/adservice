pipeline {
    agent any

    environment {
        GIT_REPO_NAME = "Microservices-E-Commerce-eks-project"
        GIT_EMAIL = "ravibhadarge15@gmail.com"
        GIT_USER_NAME = "ravibhadarge"

        DOCKER_REPO = "ravibhadarge/adservice"
        IMAGE_NAME = "adservice"
        YAML_FILE = "adservice.yaml"
    }

    stages {

        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/ravibhadarge/Microservices-E-Commerce-eks-project.git'
            }
        }

        stage('Docker Version') {
            steps {
                sh 'docker --version'
            }
        }

        stage('Docker Image Build') {
            steps {
                dir('src/adservice') {
                    sh '''
                        set -e

                        echo "=========================================="
                        echo "Building ${DOCKER_REPO}:${BUILD_NUMBER}"
                        echo "=========================================="

                        docker build \
                          -t ${DOCKER_REPO}:${BUILD_NUMBER} \
                          .
                    '''
                }
            }
        }

        stage('Docker Hub Login') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "$DOCKER_PASSWORD" | docker login \
                          --username "$DOCKER_USERNAME" \
                          --password-stdin
                    '''
                }
            }
        }

        stage('Docker Hub Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "Pushing ${DOCKER_REPO}:${BUILD_NUMBER}"

                        docker push ${DOCKER_REPO}:${BUILD_NUMBER}

                        echo "Docker Hub push successful!"
                    '''
                }
            }
        }

        stage('Update Deployment File') {
            steps {
                dir('kubernetes-files') {
                    withCredentials([
                        string(
                            credentialsId: 'my-git-pattoken',
                            variable: 'git_token'
                        )
                    ]) {
                        sh '''
                            set -e

                            git config user.email "${GIT_EMAIL}"
                            git config user.name "${GIT_USER_NAME}"

                            echo "Updating ${YAML_FILE}"
                            echo "Image: ${DOCKER_REPO}:${BUILD_NUMBER}"

                            sed -i "s#image:.*#image: ${DOCKER_REPO}:${BUILD_NUMBER}#g" ${YAML_FILE}

                            cat ${YAML_FILE}

                            git add ${YAML_FILE}

                            git diff --cached --quiet || \
                            git commit -m "Update ${IMAGE_NAME} image to version ${BUILD_NUMBER}"

                            git push \
                              https://${git_token}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git \
                              HEAD:main
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            sh 'docker logout || true'
        }

        success {
            echo "=========================================="
            echo "SUCCESS"
            echo "Docker Image: ravibhadarge/adservice:${BUILD_NUMBER}"
            echo "=========================================="
        }

        failure {
            echo "=========================================="
            echo "PIPELINE FAILED"
            echo "Check the failed stage above."
            echo "=========================================="
        }
    }
}
